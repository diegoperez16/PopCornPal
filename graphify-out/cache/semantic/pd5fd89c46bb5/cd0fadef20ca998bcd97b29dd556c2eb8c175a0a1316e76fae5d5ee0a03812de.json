{"nodes": [{"id": "docs_mobile_pwa_handoff_mobile_pwa_handoff", "label": "Mobile PWA Handoff", "file_type": "document", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_mobile_pwa_redesign", "label": "Mobile PWA Redesign", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implemented on branch codex/mobile-pwa-redesign; keeps React, Vite, Supabase, TanStack Query and Zustand; nothing deployed or submitted to an app store."}, {"id": "docs_mobile_pwa_handoff_codex_branch", "label": "codex/mobile-pwa-redesign branch", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_radial_launcher", "label": "Radial Launcher Menu", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One launcher centered in the phone viewport opens a labeled radial menu (Logging on top; Home, People, You, Library, Activity around it). Built as a native modal dialog with focus trapping, arrow-key navigation, Escape/backdrop dismissal and focus restoration; desktop uses the same destination model in its header."}, {"id": "docs_mobile_pwa_handoff_cinema_palette", "label": "Cinema Ticket Palette", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Charcoal, coral and warm paper palette plus a cinema ticket motif give the app its own identity across feed, auth, logging and collection. No new discussion backend; friends keep sharing topics in posts/comments."}, {"id": "docs_mobile_pwa_handoff_logging_sheet", "label": "Logging Sheet", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One mobile sheet with abortable cached catalog queries, visible search/server errors, validated account-scoped drafts, local calendar dates, resume/discard actions and accurate online/offline success feedback; search stays available after saving."}, {"id": "docs_mobile_pwa_handoff_episode_ratings", "label": "Episode Ratings", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows can be rated per episode; partial saves keep only unfinished episode ratings in the draft."}, {"id": "docs_mobile_pwa_handoff_collection_view", "label": "Collection View", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separates filtering/sorting from presentation and its editor; poster and list views, type filters, search, rating/editing, removal; editor shows save failures and requires a deliberate removal choice."}, {"id": "docs_mobile_pwa_handoff_logged_records_semantics", "label": "Logged Records Semantics", "file_type": "rationale", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`logged` records form the durable collection; completed/in-progress/planned records represent activity. Existing data semantics preserved."}, {"id": "docs_mobile_pwa_handoff_cover_loading", "label": "Cover Loading Wrappers", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fill poster/thumbnail frames even for landscape game art; feed photos and GIFs keep natural proportions, centered within bounded dimensions; composer previews scale proportionally."}, {"id": "docs_mobile_pwa_handoff_app_composition_root", "label": "App Composition Root", "file_type": "rationale", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App.tsx shrank from a 658-line coordinator to a small composition root; routes/session gating, lifecycle, connectivity, chunk recovery and PWA updates each have separate owners under src/app."}, {"id": "docs_mobile_pwa_handoff_app_tsx", "label": "App.tsx", "file_type": "code", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_src_app", "label": "src/app", "file_type": "code", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_supabase_auth_authority", "label": "Supabase as Authentication Authority", "file_type": "rationale", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supabase owns auth; Zustand stores only display-profile data. One initialization promise and one auth listener replace duplicate listeners; profile requests run outside the auth callback; identity generations prevent stale responses from overwriting a new account."}, {"id": "docs_mobile_pwa_handoff_account_scoped_offline_queue", "label": "Account-Scoped Offline Queue", "file_type": "rationale", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Query persistence and offline changes are partitioned by account. Atomic IndexedDB queue updates prevent enqueue/flush races; failed/auth-rejected changes stay saved; reconnect replay is serialized, across windows where Web Locks exists; mutation callbacks run offline so the queue actually receives writes."}, {"id": "docs_mobile_pwa_handoff_indexeddb", "label": "IndexedDB", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_web_locks", "label": "Web Locks API", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_pwa_icons_manifest", "label": "PWA Icons and Manifest", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proper 192px, 512px, Apple touch and dedicated maskable icons replace the incomplete placeholder set; manifest has stable ID, shortcuts, consistent branding and standalone display; zoom enabled and safe-area padding retained."}, {"id": "docs_mobile_pwa_handoff_service_worker", "label": "Service Worker Update Policy", "file_type": "rationale", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New service workers wait for a user-requested reload; already-viewed cover images can be cached; sw.js must not be cached indefinitely; the SW signals windows rather than executing authenticated writes itself."}, {"id": "docs_mobile_pwa_handoff_saved_checkout_reconciliation", "label": "Saved Checkout Reconciliation", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The saved checkout had uncommitted changes in useAddEntryPage.ts, AddEntryPage.tsx, AuthPage.tsx and index.css whose intent was carried forward; integrate deliberately, do not overwrite a newer checkout wholesale."}, {"id": "docs_mobile_pwa_handoff_validation_suite", "label": "Validation Suite", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "15 Node regression tests, 15 Playwright browser/PWA tests, TypeScript production build, git diff --check. Browser suite builds the PWA, serves on port 4173 with fixture keys, intercepts backend data in isolated contexts and never touches the real Supabase project; the test build is not deployable."}, {"id": "docs_mobile_pwa_handoff_playwright", "label": "Playwright", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_node_22", "label": "Node 22.18+", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_eslint_debt", "label": "Repository-wide ESLint Debt", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Older profile/feed/query components still report lint issues; do not describe lint as fully green."}, {"id": "docs_mobile_pwa_handoff_giphy_dependency_advisories", "label": "Giphy Dependency Advisories", "file_type": "rationale", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remaining advisories are in Giphy transitive js-cookie and uuid; do not force-downgrade the Giphy component package as a blind audit fix."}, {"id": "docs_mobile_pwa_handoff_hosting_prerequisites", "label": "Hosting Prerequisites", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steps before sharing a hosted URL: real env keys, verify schema/RLS/storage/get_feed RPC on staging, configure auth redirects, host dist behind HTTPS with SPA rewrites, device-test on iOS/Android, resolve advisories and lint debt."}, {"id": "docs_mobile_pwa_handoff_vite_env_public", "label": "VITE_* Values Are Public", "file_type": "rationale", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VITE_* variables ship to the browser; never put a Supabase service-role key there."}, {"id": "docs_mobile_pwa_handoff_get_feed_rpc", "label": "get_feed RPC", "file_type": "code", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_auth_redirects", "label": "Auth Redirects (/auth/callback, /update-password)", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_spa_rewrites_hosting", "label": "SPA Rewrites at Host", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serve manifest, icons and service worker without rewriting them to HTML."}, {"id": "docs_mobile_pwa_handoff_device_testing", "label": "Physical Device Testing", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "iOS Safari and Android Chrome: keyboard, safe areas, low connectivity, update acceptance, realtime events, optional push; Chromium automation does not replace this."}, {"id": "docs_mobile_pwa_handoff_offline_limits", "label": "Offline Support Limits", "file_type": "rationale", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth and new catalog searches need connectivity; background replay needs an open/restored window; legacy global queue records without a trustworthy owner are preserved but never replayed under a guessed account; server-generated inserts are not exactly-once after ambiguous failures (server-side idempotency is future work); without Web Locks only same-window replay dedup."}, {"id": "docs_mobile_pwa_handoff_react", "label": "React", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_vite", "label": "Vite", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_supabase", "label": "Supabase", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_tanstack_query", "label": "TanStack Query", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_zustand", "label": "Zustand", "file_type": "concept", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_mdn_manifest_icons", "label": "MDN Manifest Icons Reference", "file_type": "document", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_mobile_pwa_handoff_mdn_offline_guide", "label": "MDN Offline and Background Operation Guide", "file_type": "document", "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_mobile_pwa_handoff_mobile_pwa_redesign", "target": "docs_mobile_pwa_handoff_react", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "docs_mobile_pwa_handoff_mobile_pwa_redesign", "target": "docs_mobile_pwa_handoff_vite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "docs_mobile_pwa_handoff_mobile_pwa_redesign", "target": "docs_mobile_pwa_handoff_supabase", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "docs_mobile_pwa_handoff_mobile_pwa_redesign", "target": "docs_mobile_pwa_handoff_tanstack_query", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/MOBILE_PWA_HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "docs_mobile_pwa_handoff_mobile_pwa_redesign", "target": "docs_mobile_pwa_handoff_zustand", "relation": "references", "confidence": "EXTRACTED", "c